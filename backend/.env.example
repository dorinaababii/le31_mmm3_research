# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# ───── App ─────
APP_NAME=restaurant
DEBUG=true
SECRET_KEY=change-me-in-prod

# ───── Database ─────
# Dev (SQLite, no install needed):
DATABASE_URL=sqlite:///./restaurant.db
# Prod (Postgres):
# DATABASE_URL=postgresql+psycopg://restaurant:secret@localhost:5432/restaurant

# ───── Telegram bot ─────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram user IDs allowed to use the bot (cook + manager)
TELEGRAM_ALLOWED_USER_IDS=

# ───── LLM (for menu OCR post-processing) ─────
# Optional — if missing, OCR-only mode (less accurate)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=        # leave blank for OpenAI; set for Ollama / other compat